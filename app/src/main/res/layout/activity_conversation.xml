<?xml version='1.0' encoding='UTF-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background" android:fillViewport="true" android:fitsSystemWindows="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/primary" android:id="@+id/btnBack" android:text="← BACK" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="29sp" android:textColor="@color/ink" android:text="Two-way Conversation" android:textStyle="bold" android:layout_marginTop="18dp"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="@color/muted" android:text="One person speaks. Another person replies by typing and having Ishara speak." android:layout_marginTop="6dp"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/muted" android:text="Speaker language" android:layout_marginTop="14dp"/><Spinner android:id="@+id/speechLanguage" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_tint_v3"/><TextView android:id="@+id/txtDetectedLanguage" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/muted" android:text="" android:layout_marginTop="6dp"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/primary" android:id="@+id/txtListening" android:text="Tap Start Listening to caption the speaker in Bangla." android:layout_marginTop="16dp"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:textColor="@color/muted" android:id="@+id/txtPartial" android:text="" android:layout_marginTop="10dp"/><com.google.android.material.button.MaterialButton android:id="@+id/btnListen" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:text="Start listening" android:textAllCaps="false" android:textStyle="bold" android:textSize="15sp" android:textColor="@color/white" app:backgroundTint="@color/primary" app:strokeColor="@color/line" app:strokeWidth="1dp" app:cornerRadius="16dp"/><com.google.android.material.button.MaterialButton android:id="@+id/btnMicHelp" android:layout_width="match_parent" android:layout_height="46dp" android:text="Microphone help" android:textAllCaps="false" android:textColor="@color/primaryDark" app:backgroundTint="@color/white" app:strokeColor="@color/line" app:strokeWidth="1dp" app:cornerRadius="14dp" android:layout_marginTop="8dp"/><androidx.recyclerview.widget.RecyclerView android:id="@+id/chatList" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:clipToPadding="false" android:paddingBottom="8dp" android:minHeight="100dp" android:nestedScrollingEnabled="false"/><EditText android:id="@+id/editReply" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:padding="12dp" android:layout_marginTop="16dp" android:hint="Type your reply in Bangla…" android:background="@drawable/bg_tint_v3" android:textColor="@color/ink" android:inputType="textCapSentences|textMultiLine" android:textColorHint="@color/muted"/><com.google.android.material.button.MaterialButton android:id="@+id/btnReply" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:text="Speak &amp; send reply" android:textAllCaps="false" android:textStyle="bold" android:textSize="15sp" android:textColor="@color/white" app:backgroundTint="@color/primary" app:strokeColor="@color/line" app:strokeWidth="1dp" app:cornerRadius="16dp"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/muted" android:text="Use this feature while the app is open. The speech recognizer may stop between segments and depends on the phone’s recognition service." android:layout_marginTop="14dp"/></LinearLayout>
</ScrollView>
