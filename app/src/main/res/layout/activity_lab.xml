<?xml version='1.0' encoding='UTF-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background" android:fillViewport="true" android:fitsSystemWindows="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <com.google.android.material.button.MaterialButton android:id="@+id/btnBack" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:text="← Back" android:textSize="15sp" android:textStyle="bold" android:textAllCaps="false" android:textColor="@color/primaryDark" app:backgroundTint="@color/white" app:cornerRadius="16dp" app:strokeColor="@color/line" app:strokeWidth="1dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Inside Ishara" android:textSize="27sp" android:textColor="@color/ink" android:layout_marginTop="20dp" android:textStyle="bold"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="A hands-on look at the actual Java and Android components powering communication. Optional technical playground." android:textSize="15sp" android:textColor="@color/muted" android:layout_marginTop="7dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp" android:layout_marginTop="14dp" android:background="@drawable/bg_card_v3">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ACTIVITY LIFECYCLE" android:textSize="12sp" android:textColor="@color/primary" android:layout_marginTop="0dp" android:textStyle="bold"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Interact with the app, navigate away and return to watch Activity callbacks." android:textSize="14sp" android:textColor="@color/muted" android:layout_marginTop="5dp"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Lifecycle callback log" android:textSize="13sp" android:textColor="@color/ink" android:layout_marginTop="10dp" android:id="@+id/txtLifecycle"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp" android:layout_marginTop="14dp" android:background="@drawable/bg_card_v3">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SQLITE CRUD" android:textSize="12sp" android:textColor="@color/primary" android:layout_marginTop="0dp" android:textStyle="bold"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="A separate demonstration table protects your real conversation history." android:textSize="14sp" android:textColor="@color/muted" android:layout_marginTop="5dp"/>
      <com.google.android.material.button.MaterialButton android:id="@+id/btnCreate" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:text="CREATE sample row" android:textSize="15sp" android:textStyle="bold" android:textAllCaps="false" android:textColor="@color/white" app:backgroundTint="@color/primary" app:cornerRadius="16dp" app:strokeColor="@color/line" app:strokeWidth="1dp"/>
      <com.google.android.material.button.MaterialButton android:id="@+id/btnRead" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:text="READ latest rows" android:textSize="15sp" android:textStyle="bold" android:textAllCaps="false" android:textColor="@color/primaryDark" app:backgroundTint="@color/white" app:cornerRadius="16dp" app:strokeColor="@color/line" app:strokeWidth="1dp"/>
      <com.google.android.material.button.MaterialButton android:id="@+id/btnUpdate" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:text="UPDATE latest row" android:textSize="15sp" android:textStyle="bold" android:textAllCaps="false" android:textColor="@color/primaryDark" app:backgroundTint="@color/white" app:cornerRadius="16dp" app:strokeColor="@color/line" app:strokeWidth="1dp"/>
      <com.google.android.material.button.MaterialButton android:id="@+id/btnDelete" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:text="DELETE latest row" android:textSize="15sp" android:textStyle="bold" android:textAllCaps="false" android:textColor="@color/primaryDark" app:backgroundTint="@color/white" app:cornerRadius="16dp" app:strokeColor="@color/line" app:strokeWidth="1dp"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No sample rows yet" android:textSize="14sp" android:textColor="@color/ink" android:layout_marginTop="10dp" android:id="@+id/txtDb"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp" android:layout_marginTop="14dp" android:background="@drawable/bg_card_v3">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="JSON PARSING" android:textSize="12sp" android:textColor="@color/primary" android:layout_marginTop="0dp" android:textStyle="bold"/>
      <com.google.android.material.button.MaterialButton android:id="@+id/btnParseJson" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:text="Parse multilingual JSON example" android:textSize="15sp" android:textStyle="bold" android:textAllCaps="false" android:textColor="@color/white" app:backgroundTint="@color/primary" app:cornerRadius="16dp" app:strokeColor="@color/line" app:strokeWidth="1dp"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Press the button to parse a sample JSON object." android:textSize="14sp" android:textColor="@color/ink" android:layout_marginTop="10dp" android:id="@+id/txtJson"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp" android:layout_marginTop="14dp" android:background="@drawable/bg_card_v3">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ANDROID COMPONENTS" android:textSize="12sp" android:textColor="@color/primary" android:layout_marginTop="0dp" android:textStyle="bold"/>
      <com.google.android.material.button.MaterialButton android:id="@+id/btnBattery" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:text="Read system battery broadcast" android:textSize="15sp" android:textStyle="bold" android:textAllCaps="false" android:textColor="@color/primaryDark" app:backgroundTint="@color/white" app:cornerRadius="16dp" app:strokeColor="@color/line" app:strokeWidth="1dp"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Battery information" android:textSize="14sp" android:textColor="@color/ink" android:layout_marginTop="6dp" android:id="@+id/txtBattery"/>
      <com.google.android.material.button.MaterialButton android:id="@+id/btnSpeech" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:text="Speak through bound TTS Service" android:textSize="15sp" android:textStyle="bold" android:textAllCaps="false" android:textColor="@color/primaryDark" app:backgroundTint="@color/white" app:cornerRadius="16dp" app:strokeColor="@color/line" app:strokeWidth="1dp"/>
      <com.google.android.material.button.MaterialButton android:id="@+id/btnShare" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:text="Launch implicit sharing Intent" android:textSize="15sp" android:textStyle="bold" android:textAllCaps="false" android:textColor="@color/primaryDark" app:backgroundTint="@color/white" app:cornerRadius="16dp" app:strokeColor="@color/line" app:strokeWidth="1dp"/>
      <com.google.android.material.button.MaterialButton android:id="@+id/btnContentProvider" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:text="Open Android media ContentProvider demo" android:textSize="15sp" android:textStyle="bold" android:textAllCaps="false" android:textColor="@color/primaryDark" app:backgroundTint="@color/white" app:cornerRadius="16dp" app:strokeColor="@color/line" app:strokeWidth="1dp"/><com.google.android.material.button.MaterialButton android:id="@+id/btnNetworking" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:text="Open Firebase Realtime Database room" android:textSize="15sp" android:textStyle="bold" android:textAllCaps="false" android:textColor="@color/primaryDark" app:backgroundTint="@color/white" app:cornerRadius="16dp" app:strokeColor="@color/line" app:strokeWidth="1dp"/>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Try Picture Board for the Android Photo Picker and ContentResolver, Settings for system broadcasts and HTTP/JSON, and Connect for Firebase Realtime Database. These are real components, not simulated buttons." android:textSize="13sp" android:textColor="@color/muted" android:layout_marginTop="15dp"/>
  </LinearLayout>
</ScrollView>
