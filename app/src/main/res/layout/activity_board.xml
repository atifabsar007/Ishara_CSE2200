<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background" android:fillViewport="true" android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="22dp">
        <TextView android:id="@+id/btnBack" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="← BACK" android:textSize="13sp" android:textColor="@color/primary" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="Picture Board" android:textSize="29sp"
            android:textColor="@color/ink" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="Choose a ready-made message or a picture to support communication."
            android:textSize="14sp" android:textColor="@color/muted"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp" android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_v3">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="YOUR OWN PICTURE" android:textSize="12sp" android:textColor="@color/primary" android:textStyle="bold"/>
            <TextView android:id="@+id/txtImageInfo" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="No image selected. Choose a photo to demonstrate Android media access."
                android:textSize="13sp" android:textColor="@color/muted"/>
            <ImageView android:id="@+id/imgSelected" android:layout_width="match_parent" android:layout_height="190dp"
                android:layout_marginTop="10dp" android:scaleType="centerCrop" android:contentDescription="Selected communication picture"
                android:visibility="gone" android:background="@drawable/bg_tint_v3"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnAddImage"
                android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp"
                android:text="Choose image from phone" android:textAllCaps="false" android:textColor="@color/primaryDark"
                app:backgroundTint="@color/white" app:cornerRadius="14dp" app:strokeColor="@color/line" app:strokeWidth="1dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnClearImage"
                android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp"
                android:text="Clear selected image" android:textAllCaps="false" android:visibility="gone"
                android:textColor="@color/primaryDark" app:backgroundTint="@color/primarySoft" app:cornerRadius="14dp"/>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="EVERYDAY COMMUNICATION" android:textSize="12sp"
            android:textColor="@color/primary" android:textStyle="bold"/>
        <TextView android:id="@+id/txtBoardSelection" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:padding="18dp" android:background="@drawable/bg_card_v3"
            android:text="Tap a message tile below" android:textSize="21sp" android:textStyle="bold" android:textColor="@color/ink"/>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/boardList" android:layout_width="match_parent"
            android:layout_height="440dp" android:layout_marginTop="12dp" android:clipToPadding="false" android:paddingBottom="8dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSpeak" android:layout_width="match_parent"
            android:layout_height="54dp" android:layout_marginTop="12dp" android:text="Speak selected message"
            android:textAllCaps="false" android:textStyle="bold" android:textSize="15sp" android:textColor="@color/white"
            app:backgroundTint="@color/primary" app:cornerRadius="16dp"/>
    </LinearLayout>
</ScrollView>
