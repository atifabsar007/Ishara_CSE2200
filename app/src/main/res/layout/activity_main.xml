<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background" android:fitsSystemWindows="true" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="ISHARA  •  COMMUNICATE BEYOND WORDS"
            android:textSize="11sp" android:textColor="@color/primary" android:textStyle="bold"/>
        <TextView android:id="@+id/txtHello" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="Hello 👋" android:textSize="27sp"
            android:textColor="@color/ink" android:textStyle="bold"/>
        <TextView android:id="@+id/txtAccount" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="Private device space" android:textSize="13sp" android:textColor="@color/muted"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" android:orientation="vertical" android:padding="20dp"
            android:background="@drawable/bg_dark_v3">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="YOUR MAIN COMMUNICATION TOOL" android:textSize="11sp" android:textColor="@color/accent" android:textStyle="bold"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="Gesture-to-text studio" android:textSize="25sp"
                android:textColor="@color/white" android:textStyle="bold"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="Show a supported hand gesture, review the detected handshape, build a message and speak it aloud."
                android:textSize="15sp" android:textColor="@color/white"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCamera"
                android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="14dp"
                android:text="Open gesture camera  →" android:textAllCaps="false" android:textSize="15sp"
                android:textStyle="bold" android:textColor="@color/primaryDark" app:backgroundTint="@color/white"
                app:cornerRadius="16dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:orientation="vertical" android:padding="19dp"
            android:background="@drawable/bg_card_v3">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="LIVE CAPTIONS" android:textSize="11sp" android:textColor="@color/primary" android:textStyle="bold"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="7dp" android:text="Live conversation captions" android:textSize="20sp"
                android:textColor="@color/ink" android:textStyle="bold"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="Turn spoken conversations or lectures into readable text in Bangla or English."
                android:textSize="14sp" android:textColor="@color/muted"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCaptions"
                android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp"
                android:text="Open live captions  →" android:textAllCaps="false" android:textSize="15sp"
                android:textStyle="bold" android:textColor="@color/primaryDark" app:backgroundTint="@color/white"
                app:cornerRadius="15dp" app:strokeColor="@color/line" app:strokeWidth="1dp"/>
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="PLAY  •  LEARN  •  CONNECT" android:textSize="12sp"
            android:textColor="@color/primary" android:textStyle="bold"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="9dp" android:orientation="horizontal" android:weightSum="3">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnQuest"
                android:layout_width="0dp" android:layout_height="82dp" android:layout_weight="1"
                android:layout_marginEnd="5dp" android:text="Play\nIshara Quest" android:textAllCaps="false"
                android:textSize="13sp" android:textStyle="bold" android:textColor="@color/primaryDark"
                app:backgroundTint="@color/primarySoft" app:cornerRadius="15dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnLearn"
                android:layout_width="0dp" android:layout_height="82dp" android:layout_weight="1"
                android:layout_marginHorizontal="3dp" android:text="Learn\nGestures" android:textAllCaps="false"
                android:textSize="13sp" android:textStyle="bold" android:textColor="@color/primaryDark"
                app:backgroundTint="@color/primarySoft" app:cornerRadius="15dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnPeer"
                android:layout_width="0dp" android:layout_height="82dp" android:layout_weight="1"
                android:layout_marginStart="5dp" android:text="Connect\nLive room" android:textAllCaps="false"
                android:textSize="13sp" android:textStyle="bold" android:textColor="@color/primaryDark"
                app:backgroundTint="@color/primarySoft" app:cornerRadius="15dp"/>
        </LinearLayout>
        <TextView android:id="@+id/txtQuestScore" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="0 points earned  •  0 puzzles solved"
            android:textSize="12sp" android:textColor="@color/muted"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="25dp" android:text="MORE COMMUNICATION TOOLS" android:textSize="12sp"
            android:textColor="@color/primary" android:textStyle="bold"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:orientation="vertical" android:padding="14dp" android:background="@drawable/bg_card_v3">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnConversation"
                android:layout_width="match_parent" android:layout_height="50dp" android:text="Two-way conversation  →"
                android:textAllCaps="false" android:textColor="@color/primaryDark" app:backgroundTint="@color/white"
                app:cornerRadius="14dp" app:strokeColor="@color/line" app:strokeWidth="1dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnBuilder"
                android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="7dp"
                android:text="Sentence builder" android:textAllCaps="false" android:textColor="@color/primaryDark"
                app:backgroundTint="@color/white" app:cornerRadius="14dp" app:strokeColor="@color/line" app:strokeWidth="1dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnBoard"
                android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="7dp"
                android:text="Picture communication board" android:textAllCaps="false" android:textColor="@color/primaryDark"
                app:backgroundTint="@color/white" app:cornerRadius="14dp" app:strokeColor="@color/line" app:strokeWidth="1dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnPhrases"
                android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="7dp"
                android:text="Quick phrases" android:textAllCaps="false" android:textColor="@color/primaryDark"
                app:backgroundTint="@color/white" app:cornerRadius="14dp" app:strokeColor="@color/line" app:strokeWidth="1dp"/>
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="25dp" android:text="LEARNING &amp; PERSONAL PROGRESS" android:textSize="12sp"
            android:textColor="@color/primary" android:textStyle="bold"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:orientation="vertical" android:padding="14dp" android:background="@drawable/bg_card_v3">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnDictionary"
                android:layout_width="match_parent" android:layout_height="48dp" android:text="Gesture dictionary"
                android:textAllCaps="false" android:textColor="@color/primaryDark" app:backgroundTint="@color/white" app:cornerRadius="13dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCalibration"
                android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp"
                android:text="Gesture calibration &amp; corrections" android:textAllCaps="false"
                android:textColor="@color/primaryDark" app:backgroundTint="@color/white" app:cornerRadius="13dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnProgress"
                android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp"
                android:text="Practice progress &amp; cloud sync" android:textAllCaps="false"
                android:textColor="@color/primaryDark" app:backgroundTint="@color/white" app:cornerRadius="13dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnSimulator"
                android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp"
                android:text="Real-life scenario practice" android:textAllCaps="false"
                android:textColor="@color/primaryDark" app:backgroundTint="@color/white" app:cornerRadius="13dp"/>
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="25dp" android:text="YOUR MESSAGES" android:textSize="12sp"
            android:textColor="@color/primary" android:textStyle="bold"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:orientation="vertical" android:padding="15dp" android:background="@drawable/bg_card_v3">
            <TextView android:id="@+id/txtAdaptive" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Your frequently used messages appear here." android:textSize="14sp" android:textColor="@color/ink"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnUseTop"
                android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp"
                android:text="Speak your top phrase" android:textAllCaps="false" android:textColor="@color/primaryDark"
                app:backgroundTint="@color/white" app:cornerRadius="13dp" app:strokeColor="@color/line" app:strokeWidth="1dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnHistory"
                android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp"
                android:text="Message history" android:textAllCaps="false" android:textColor="@color/primaryDark"
                app:backgroundTint="@color/white" app:cornerRadius="13dp" app:strokeColor="@color/line" app:strokeWidth="1dp"/>
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="25dp" android:text="PROJECT SHOWCASE &amp; SETTINGS" android:textSize="12sp"
            android:textColor="@color/primary" android:textStyle="bold"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:orientation="vertical" android:padding="14dp" android:background="@drawable/bg_card_v3">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnLab"
                android:layout_width="match_parent" android:layout_height="48dp" android:text="CSE 2200 lab showcase"
                android:textAllCaps="false" android:textColor="@color/primaryDark" app:backgroundTint="@color/white" app:cornerRadius="13dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnSettings"
                android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp"
                android:text="System tools, API &amp; Firebase" android:textAllCaps="false" android:textColor="@color/primaryDark"
                app:backgroundTint="@color/white" app:cornerRadius="13dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnAbout"
                android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp"
                android:text="About Ishara" android:textAllCaps="false" android:textColor="@color/primaryDark"
                app:backgroundTint="@color/white" app:cornerRadius="13dp"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton android:id="@+id/btnLogout"
            android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="20dp"
            android:text="Log out / switch account" android:textAllCaps="false" android:textColor="@color/primaryDark"
            app:backgroundTint="@color/white" app:cornerRadius="15dp" app:strokeColor="@color/line" app:strokeWidth="1dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="15dp" android:gravity="center" android:text="Created by Md. Atif Absar"
            android:textSize="12sp" android:textColor="@color/muted"/>
    </LinearLayout>
</ScrollView>
