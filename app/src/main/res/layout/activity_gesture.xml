<?xml version='1.0' encoding='UTF-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fitsSystemWindows="true" android:fillViewport="true" android:background="@color/background">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
      <com.google.android.material.button.MaterialButton android:id="@+id/btnBack" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Widget.MaterialComponents.Button.TextButton" android:text="← Back"/>
      <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Live gesture studio" android:textColor="@color/ink" android:textSize="22sp" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CAMERA + ON-DEVICE AI" android:textSize="10sp" android:letterSpacing="0.11" android:textColor="@color/muted"/>
      </LinearLayout>
      <com.google.android.material.button.MaterialButton android:id="@+id/btnSwitchCamera" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:text="↻ Flip"/>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardCornerRadius="23dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/line">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/white">
        <FrameLayout android:layout_width="match_parent" android:layout_height="336dp">
          <androidx.camera.view.PreviewView android:id="@+id/cameraPreview" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/primaryDark" app:implementationMode="compatible" app:scaleType="fillCenter"/>
          <com.kuet.ishara.ui.HandLandmarkOverlay android:id="@+id/landmarkOverlay" android:layout_width="match_parent" android:layout_height="match_parent"/>
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_gravity="top" android:padding="12dp">
            <TextView android:id="@+id/txtCameraMode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●  FRONT CAMERA" android:textSize="11sp" android:letterSpacing="0.08" android:textStyle="bold" android:textColor="@color/white" android:padding="9dp" android:background="@drawable/bg_label"/>
            <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp"/>
            <TextView android:id="@+id/txtAiBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SETTING UP" android:textColor="@color/accent" android:textSize="11sp" android:textStyle="bold" android:padding="9dp" android:background="@drawable/bg_label"/>
          </LinearLayout>
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|center_horizontal" android:layout_margin="14dp" android:text="Position one hand in view · hold still" android:textSize="12sp" android:textColor="@color/white" android:background="@drawable/bg_label" android:padding="9dp"/>
        </FrameLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp" android:orientation="vertical">
          <TextView android:id="@+id/txtCameraStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Preparing hand recognition…" android:textColor="@color/ink" android:textSize="14sp"/>
          <ProgressBar android:id="@+id/modelProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="10dp" android:progressTint="@color/primary" android:progress="0" android:max="100" android:visibility="gone"/>
          <com.google.android.material.button.MaterialButton android:id="@+id/btnRetryModel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Download / retry gesture AI" android:visibility="gone"/>
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tip: The emulator shows a virtual scene unless a webcam is configured. Use a real phone for reliable gesture tests." android:textSize="11sp" android:layout_marginTop="7dp" android:textColor="@color/muted"/>
        </LinearLayout>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="16dp">
      <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Conversation context" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/ink"/>
      <Spinner android:id="@+id/contextSpinner" android:layout_width="150dp" android:layout_height="48dp" android:contentDescription="Choose context for demo phrase mapping" android:background="@drawable/bg_sentence"/>
    </LinearLayout>
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardBackgroundColor="@color/white" app:cardCornerRadius="22dp" app:cardElevation="0dp" app:strokeColor="@color/line" app:strokeWidth="1dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="LAST RECOGNIZED PHRASE" android:textSize="11sp" android:letterSpacing="0.1" android:textColor="@color/primary" android:textStyle="bold"/>
        <TextView android:id="@+id/txtDetected" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="ইশারা দেখান…" android:textSize="28sp" android:textStyle="bold" android:textColor="@color/ink" android:minHeight="58dp" android:gravity="center_vertical" android:contentDescription="Recognized Bangla phrase. Tap to add to sentence"/>
        <TextView android:id="@+id/txtGestureLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Waiting for a gesture" android:textColor="@color/muted" android:textSize="13sp"/>
        <com.kuet.ishara.ui.GestureStatusView android:id="@+id/confidenceView" android:layout_width="match_parent" android:layout_height="23dp" android:layout_marginTop="14dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tap the phrase or + Add to compose your message" android:textColor="@color/muted" android:textSize="11sp" android:layout_marginTop="7dp"/>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchLandmarks" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Show 21-point hand landmarks" android:checked="true" android:textSize="13sp" android:textColor="@color/ink" android:layout_marginTop="12dp"/><com.google.android.material.button.MaterialButton android:id="@+id/btnCalibration" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:text="Calibrate recognition / correct last result"/><com.google.android.material.button.MaterialButton android:id="@+id/btnDictionary" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:text="Open illustrated gesture dictionary"/><com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchAutoAdd" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Auto-add recognized gestures to sentence" android:textSize="13sp" android:textColor="@color/ink" android:checked="false" android:layout_marginTop="14dp"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/btnPause" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:text="Pause scanning"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/btnSuggestSentence" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:text="Suggest natural Bangla sentence"/><TextView android:id="@+id/txtSuggestedSentence" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="15sp" android:textColor="@color/primary" android:padding="6dp"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="YOUR MESSAGE" android:layout_marginTop="15dp" android:textColor="@color/primary" android:textSize="12sp" android:textStyle="bold"/>
    <TextView android:id="@+id/txtSentence" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="80dp" android:padding="18dp" android:textSize="19sp" android:textColor="@color/ink" android:background="@drawable/bg_sentence" android:layout_marginTop="8dp" android:hint="Build a Bangla sentence with multiple gestures" android:textColorHint="@color/muted"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
      <com.google.android.material.button.MaterialButton android:id="@+id/btnAdd" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="+ Add"/>
      <com.google.android.material.button.MaterialButton android:id="@+id/btnSpeak" android:layout_width="0dp" android:layout_weight="1.15" android:layout_height="wrap_content" android:text="▶ Speak"/>
      <com.google.android.material.button.MaterialButton android:id="@+id/btnSave" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Save"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
      <com.google.android.material.button.MaterialButton android:id="@+id/btnUndo" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:text="Undo"/>
      <com.google.android.material.button.MaterialButton android:id="@+id/btnClear" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:text="Clear"/>
      <com.google.android.material.button.MaterialButton android:id="@+id/btnShare" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:text="Share"/>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="7 supported handshapes · Thumbs up/down, open palm, closed fist, victory, pointing up and I-Love-You. Custom demo mappings, not Bangla Sign Language." android:layout_marginTop="13dp" android:textSize="12sp" android:textColor="@color/muted" android:gravity="center"/>
  <com.google.android.material.button.MaterialButton android:id="@+id/btnPeerShare" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:text="Send message via Peer Link" android:textSize="15sp" android:textStyle="bold" android:textAllCaps="false" android:textColor="@color/primaryDark" app:backgroundTint="@color/white" app:cornerRadius="16dp" app:strokeColor="@color/line" app:strokeWidth="1dp"/></LinearLayout>
</ScrollView>
