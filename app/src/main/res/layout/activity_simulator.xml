<?xml version='1.0' encoding='UTF-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background" android:fillViewport="true" android:fitsSystemWindows="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <com.google.android.material.button.MaterialButton android:id="@+id/btnBack" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:text="← Back" android:textSize="15sp" android:textStyle="bold" android:textAllCaps="false" android:textColor="@color/primaryDark" app:backgroundTint="@color/white" app:cornerRadius="16dp" app:strokeColor="@color/line" app:strokeWidth="1dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Everyday Simulator" android:textSize="27sp" android:textColor="@color/ink" android:layout_marginTop="20dp" android:textStyle="bold"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Practice communicating at a café, clinic, bus stop or with a new friend. Every response leads somewhere." android:textSize="15sp" android:textColor="@color/muted" android:layout_marginTop="7dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp" android:layout_marginTop="14dp" android:background="@drawable/bg_card_v3">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CHOOSE A SITUATION" android:textSize="12sp" android:textColor="@color/primary" android:layout_marginTop="0dp" android:textStyle="bold"/>
      <Spinner android:id="@+id/scenarioSpinner" android:layout_width="match_parent" android:layout_height="56dp"/>
      <com.google.android.material.button.MaterialButton android:id="@+id/btnBegin" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:text="Start scenario" android:textSize="15sp" android:textStyle="bold" android:textAllCaps="false" android:textColor="@color/white" app:backgroundTint="@color/primary" app:cornerRadius="16dp" app:strokeColor="@color/line" app:strokeWidth="1dp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp" android:layout_marginTop="14dp" android:background="@drawable/bg_card_v3">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Scenario ready" android:textSize="22sp" android:textColor="@color/ink" android:layout_marginTop="0dp" android:id="@+id/txtScenarioName" android:textStyle="bold"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Select a scenario to begin." android:textSize="14sp" android:textColor="@color/muted" android:layout_marginTop="5dp" android:id="@+id/txtScenarioDescription"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="This run: 0 points" android:textSize="13sp" android:textColor="@color/primary" android:layout_marginTop="14dp" android:id="@+id/txtScenarioScore" android:textStyle="bold"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="A question appears here" android:textSize="20sp" android:textColor="@color/ink" android:layout_marginTop="15dp" android:id="@+id/txtPrompt" android:textStyle="bold"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Choose a response that works for you." android:textSize="14sp" android:textColor="@color/muted" android:layout_marginTop="7dp" android:id="@+id/txtContext"/>
      <LinearLayout android:id="@+id/choiceContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your choices lead to different outcomes." android:textSize="14sp" android:textColor="@color/primary" android:layout_marginTop="12dp" android:id="@+id/txtFeedback"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp" android:layout_marginTop="14dp" android:background="@drawable/bg_card_v3">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="YOUR PRACTICE PROGRESS" android:textSize="12sp" android:textColor="@color/primary" android:layout_marginTop="0dp" android:textStyle="bold"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No finished scenarios yet" android:textSize="16sp" android:textColor="@color/ink" android:layout_marginTop="8dp" android:id="@+id/txtLifetimeScore" android:textStyle="bold"/>
      <com.google.android.material.button.MaterialButton android:id="@+id/btnSpeak" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:text="Speak selected response" android:textSize="15sp" android:textStyle="bold" android:textAllCaps="false" android:textColor="@color/primaryDark" app:backgroundTint="@color/white" app:cornerRadius="16dp" app:strokeColor="@color/line" app:strokeWidth="1dp"/>
      <com.google.android.material.button.MaterialButton android:id="@+id/btnShare" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:text="Share selected response" android:textSize="15sp" android:textStyle="bold" android:textAllCaps="false" android:textColor="@color/primaryDark" app:backgroundTint="@color/white" app:cornerRadius="16dp" app:strokeColor="@color/line" app:strokeWidth="1dp"/>
      <com.google.android.material.button.MaterialButton android:id="@+id/btnRestart" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:text="Restart this scenario" android:textSize="15sp" android:textStyle="bold" android:textAllCaps="false" android:textColor="@color/primaryDark" app:backgroundTint="@color/white" app:cornerRadius="16dp" app:strokeColor="@color/line" app:strokeWidth="1dp"/>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="These are role-play examples, not instructions for a real emergency or medical diagnosis. Any respectful communication method is valid." android:textSize="12sp" android:textColor="@color/muted" android:layout_marginTop="16dp"/>
  </LinearLayout>
</ScrollView>
